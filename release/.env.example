# Hostinger Production Environment Example
# Copy this file to .env on the server only.
# Never upload real .env publicly and never commit real secrets to GitHub.

APP_NAME="Habiba Nabil Arabic Academy"
APP_ENV=production
APP_DEBUG=false
APP_URL=https://mshabibanabil.com
APP_TIMEZONE=Asia/Dubai

# MySQL / MariaDB — Hostinger database values
DB_HOST=localhost
DB_PORT=3306
DB_NAME=your_hostinger_database_name
DB_USER=your_hostinger_database_user
DB_PASS=your_strong_database_password
DB_CHARSET=utf8mb4

# Security
APP_KEY=replace_with_long_random_secret_at_least_32_chars
AUTH_SECRET=replace_with_long_random_secret_if_used
SESSION_SECRET=replace_with_long_random_secret_if_used
SECURITY_HASH_PEPPER=replace_with_private_random_hash_pepper
SESSION_NAME=hn_academy_session
LOGIN_MAX_ATTEMPTS=8
LOGIN_WINDOW_SECONDS=900
FORCE_HTTPS=true

# Upload and storage
UPLOAD_STORAGE_DRIVER=local
UPLOAD_BASE_PATH=./uploads
PUBLIC_ASSETS_BASE_PATH=./public/assets
PUBLIC_FILE_BASE_URL=https://mshabibanabil.com
MAX_AUDIO_UPLOAD_BYTES=26214400
MAX_VIDEO_UPLOAD_BYTES=209715200
MAX_IMAGE_UPLOAD_BYTES=10485760
MAX_DOCUMENT_UPLOAD_BYTES=52428800
MAX_HTML_UPLOAD_BYTES=2097152
UPLOAD_MAX_SIZE=52428800

# AI — optional, server-side only
AI_ENABLED=false
AI_PROVIDER=anthropic
AI_MODEL=
AI_API_KEY=
AI_MONTHLY_LIMIT=
AI_REGENERATE_LIMIT=3

# Ziina payment — server-side only
ZIINA_API_BASE=https://api-v2.ziina.com/api
ZIINA_API_TOKEN=
ZIINA_API_KEY=
ZIINA_TEST_MODE=true
ZIINA_WEBHOOK_SECRET=

# Email provider — optional
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM_EMAIL=
EMAIL_FROM_NAME="Habiba Nabil Arabic Academy"
MAIL_FROM_EMAIL=
MAIL_FROM_NAME="Habiba Nabil Arabic Academy"

# WhatsApp provider — optional
WHATSAPP_PROVIDER=
WHATSAPP_API_TOKEN=

# Firebase — optional, server-side only
FIREBASE_ENABLED=false
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nPLACEHOLDER_ONLY\n-----END PRIVATE KEY-----\n"
FIREBASE_SERVER_KEY=
FIREBASE_SERVICE_ACCOUNT_JSON=

# Cron jobs — optional
CRON_SECRET=replace_with_random_cron_secret

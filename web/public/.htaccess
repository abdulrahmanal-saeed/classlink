# Clean URL support for Apache hosting.
# Public detail pages use rewrites while files stay organized.

Options -Indexes

<IfModule mod_rewrite.c>
  RewriteEngine On

  # API clean routes
  RewriteRule ^api/auth/login/?$ /api/auth/login.php [L]
  RewriteRule ^api/auth/logout/?$ /api/auth/logout.php [L]
  RewriteRule ^api/auth/me/?$ /api/auth/me.php [L]

  # Public CMS detail routes
  RewriteRule ^articles/([^/]+)/?$ /articles/index.php?slug=$1 [L,QSA]
  RewriteRule ^videos/([^/]+)/?$ /videos/index.php?slug=$1 [L,QSA]

  # Owner clean detail route
  RewriteRule ^owner/payments/([0-9]+)/?$ /owner/payments/view/index.php?id=$1 [L,QSA]

  # Clean page routes are directory-based: /login, /pricing, /owner/dashboard, etc.
</IfModule>

# Application
APP_NAME="Habiba Nabil Arabic Academy"
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost
APP_TIMEZONE=Asia/Dubai

# Database
# Active database: MySQL / MariaDB.
# Production should use the Hostinger MySQL database credentials.
# Do not use Replit internal @base database.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=habiba_nabil_saas
DB_USER=root
DB_PASS=
DB_CHARSET=utf8mb4

# Security
APP_KEY=change_this_to_a_long_random_secret_at_least_32_chars
SECURITY_HASH_PEPPER=change_this_to_a_random_private_pepper
SESSION_NAME=hn_academy_session
LOGIN_MAX_ATTEMPTS=8
LOGIN_WINDOW_SECONDS=900
FORCE_HTTPS=false

# Upload limits
MAX_AUDIO_UPLOAD_BYTES=26214400
MAX_VIDEO_UPLOAD_BYTES=209715200
MAX_IMAGE_UPLOAD_BYTES=10485760
MAX_DOCUMENT_UPLOAD_BYTES=52428800
MAX_HTML_UPLOAD_BYTES=2097152
UPLOAD_STORAGE_DRIVER=local
UPLOAD_BASE_PATH=./uploads
PUBLIC_ASSETS_BASE_PATH=./public/assets
PUBLIC_FILE_BASE_URL=

# Firebase support - optional, server-side only
FIREBASE_ENABLED=false
FIREBASE_PROJECT_ID=
FIREBASE_SERVER_KEY=
FIREBASE_SERVICE_ACCOUNT_JSON=

# Mail and WhatsApp placeholders - optional, server-side only
MAIL_FROM_EMAIL=
MAIL_FROM_NAME="Habiba Nabil Arabic Academy"
WHATSAPP_PROVIDER=
WHATSAPP_API_TOKEN=

# AI provider settings - server-side only
AI_ENABLED=false
AI_PROVIDER=anthropic
AI_MODEL=
AI_API_KEY=
AI_MONTHLY_LIMIT=
AI_REGENERATE_LIMIT=3

# Ziina payment API - keep real values in server .env only, never in GitHub
ZIINA_API_BASE=https://api-v2.ziina.com/api
ZIINA_API_TOKEN=
ZIINA_TEST_MODE=true

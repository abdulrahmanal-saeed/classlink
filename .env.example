# Application
APP_NAME="Habiba Nabil Arabic Academy"
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost
APP_TIMEZONE=Asia/Dubai

# Database
DB_HOST=localhost
DB_PORT=3306
DB_NAME=habiba_nabil_saas
DB_USER=root
DB_PASS=
DB_CHARSET=utf8mb4

# Security
APP_KEY=change_this_to_a_long_random_secret
SESSION_NAME=hn_academy_session

# Firebase support - optional
FIREBASE_ENABLED=false
FIREBASE_PROJECT_ID=
FIREBASE_SERVER_KEY=

# Mail and WhatsApp placeholders - optional
MAIL_FROM_EMAIL=
MAIL_FROM_NAME="Habiba Nabil Arabic Academy"
WHATSAPP_PROVIDER=
WHATSAPP_API_TOKEN=

# Ziina payment API - keep real values in server .env only, never in GitHub
ZIINA_API_BASE=https://api-v2.ziina.com/api
ZIINA_API_TOKEN=
ZIINA_TEST_MODE=true
